# 전체 AI 추천·문서 분석 테스트에 사용합니다. 키가 없으면 로컬 대체 결과가 표시됩니다.
UPSTAGE_API_KEY=

# 아래 이메일과 API 키는 data/contract-templates.json의 템플릿에 접근 가능한
# 같은 모두싸인 워크스페이스에서 발급해야 합니다.
MODUSIGN_EMAIL=
MODUSIGN_API_KEY=

# 템플릿 역할을 자동으로 찾지 못하면 모두싸인 템플릿의 역할 이름을 그대로 입력합니다.
# 예: 참여자, 예약자, 고객, 서명자
MODUSIGN_SIGNER_ROLE=

# 비워 두면 3000번 포트를 사용합니다.
PORT=3000
